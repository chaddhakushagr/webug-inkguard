# Application Environment (development, staging, production)
APP_ENV=development

# Database URL: SQLite locally, Neon PostgreSQL on cloud
DATABASE_URL=sqlite:///./data/inkguard.db

# Authentication
JWT_SECRET=inkguard-insecure-dev-secret-change-in-production-1234567890
DEMO_MODE=true
DEMO_PASSWORD=LumoDemo2026!

# LLM Configuration (live, cached, mock, rules_only)
LLM_MODE=mock
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GOOGLE_API_KEY=your-google-api-key-here
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_DAILY_CAP=100

# Constraints and Rate Limits
MAX_CONTENT_CHARS=20000
RATE_LIMIT_REVIEWS_PER_HOUR=60
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOW_SEED_RESET=true
CLAIM_CONFIDENCE_THRESHOLD=0.75
VERIFIER_ENABLED=false

# Frontend public API base
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
